# Copy to .env and fill in. .env is gitignored and never read into config YAML.
# Every value here is held as a SecretStr and redacted from all log output.

# --- Polymarket (only needed for live execution) ---------------------------
# The key that can move funds. Use a dedicated wallet funded with only the
# bankroll you are willing to lose.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# --- Market data (public endpoints work unauthenticated; keys raise limits) -
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Regime-tier sources (all optional; disabled sources ignore these) ------
COINGLASS_API_KEY=
GLASSNODE_API_KEY=
CRYPTOQUANT_API_KEY=
NEWS_API_KEY=
TWITTER_BEARER_TOKEN=

# --- Ops -------------------------------------------------------------------
ALERT_WEBHOOK_URL=

# --- Overrides -------------------------------------------------------------
# PMBTC_CONFIG=config/config.yaml
# PMBTC_APP__MODE=paper
# PMBTC_DB_URL=postgresql+asyncpg://user:pass@localhost/pmbtc

# Third and final live-trading interlock. Leave unset unless you mean it.
# PMBTC_I_UNDERSTAND_LIVE_RISK=yes
